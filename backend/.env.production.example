# ========================================
# VARIABLES DE ENTORNO PARA PRODUCCION
# Copiar a Railway como variables de entorno
# ========================================

# Base de Datos (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Redis (Railway Redis)
REDIS_URL=redis://default:password@host:port

# Celery
CELERY_BROKER_URL=redis://default:password@host:port
CELERY_RESULT_BACKEND=redis://default:password@host:port

# Seguridad - IMPORTANTE: Generar una clave secreta fuerte
# Puedes generar una con: openssl rand -hex 32
SECRET_KEY=tu-clave-secreta-muy-segura-de-al-menos-32-caracteres

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - Dominios permitidos (separados por coma)
BACKEND_CORS_ORIGINS=["https://sistema.canteralarufina.com.ar"]

# Cloudinary (opcional - para subir imagenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
